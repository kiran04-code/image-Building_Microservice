# ImageForge Frontend - Development Environment Variables
# Default: Point to deployed backend on Vercel
VITE_API_BASE_URL=https://image-building-microservice-hanr.vercel.app
VITE_BUILD_API_URL=https://image-building-microservice-hanr.vercel.app/api/builds

# If you want to use local Express backend on port 3001, uncomment the lines below:
# VITE_API_BASE_URL=http://localhost:3001
# VITE_BUILD_API_URL=http://localhost:3001/api/builds
