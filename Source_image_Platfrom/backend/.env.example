# Backend server
PORT=3001

# AWS account and region where CodeBuild runs
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=395799817837

# IAM credentials used by this backend to start and inspect CodeBuild jobs.
# Never commit real values. Use an IAM user/role with CodeBuild permissions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= # Only required for temporary credentials.

# Existing CodeBuild project. It must use a privileged Docker environment.
AWS_CODEBUILD_PROJECT_NAME=imageforge-ecr-builder

# For Amazon ECR Public Gallery:
ECR_REGISTRY=public.ecr.aws/c4g7m5c8
ECR_REPOSITORY=imageforge/apps

# (Or for Private ECR):
# ECR_REGISTRY=395799817837.dkr.ecr.ap-south-1.amazonaws.com
# ECR_REPOSITORY=imageforge

